#include <stdio.h>
int main(){
    int marks;
    scanf("%d", &marks);
    if(marks<0 || marks>100){
        printf("?\n");
        return 0;
    }
    switch(marks/10){
        case 10:
        case 9: printf("S\n"); break;
        case 8: printf("A\n"); break;
        case 7: printf("B\n"); break;
        case 6: printf("C\n"); break;
        case 5: printf("D\n"); break;
        default: printf("F\n");
    }
    return 0;
}
