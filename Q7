#include <stdio.h>
int main(){
    long n;
    scanf("%ld", &n);
    int prime=1;
    if(n<2) prime=0;
    else if(n==2) prime=1;
    else if(n%2==0) prime=0;
    else{
        for(long i=3; i*i<=n; i+=2){
            if(n%i==0){ prime=0; break; }
        }
    }
    if(prime) printf("prime\n");
    else printf("not prime\n");
    return 0;
}
