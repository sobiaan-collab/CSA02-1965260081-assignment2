#include <stdio.h>
int main(){
    long n;
    scanf("%ld", &n);
    long count=0;
    int prime=1;
    if(n<2) prime=0;
    else{
        for(long i=2; i*i<=n; i++){
            count++;
            if(n%i==0){ prime=0; break; }
        }
    }
    if(prime==1) printf("prime ");
    else printf("not prime ");
    printf("divisions=%ld", count);
    return 0;
}
